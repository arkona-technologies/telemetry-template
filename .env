# Telemetry config

BLADES=

DB_NAME=bladerunner
DB_PASSWORD=blade__runner # at least 8 characters!
DB_USER=arkona
DB_PORT=8181 # default port in container, on host mapped to :8086 via docker-compose port mapping!
DB_ORG=arkona
RETENTION_PERIOD=4d # can be n d/w (days/weeks)
DB_TOKEN=

GRAFANA_USER=arkona
GRAFANA_PW=arkona

# Resources config

INFLUX3_MAX_MEMORY_BYTES=
INFLUX3_QUERY_MEMORY_POOL_BYTES=
INFLUX3_SINGLE_QUERY_MEMORY_LIMIT_BYTES=
INFLUX_CONTAINER_MEM_LIMIT=
ALLOY_MEM_LIMIT=
GRAFANA_MEM_LIMIT=
LOKI_MEM_LIMIT=
LOKI_GOMEMLIMIT=

# Export script config

# Defines the start time for the export in seconds relative to NOW, if empty -> defaults to 86400s (24h)
DURATION_S=
# Defines the time steps for the export in seconds relative to NOW, if empty -> defaults to 600s (10 min)
STEP_DURATION_S=
# Path to export file (.csv!), default ./export.csv
OUTPUT_FILE=